// External SPI flash. From https://github.com/sipeed/TangNano-9K-example
// (picotiny/project/picotiny.cst). These are the MSPI pins, so the bitstream
// must be packed with gowin_pack --mspi_as_gpio (as Apicula's tangnano9k
// examples do: https://github.com/YosysHQ/apicula/blob/master/examples/Makefile).
IO_LOC "flash_clk" 59;
IO_PORT "flash_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "flash_cs_n" 60;
IO_PORT "flash_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "flash_mosi" 61;
IO_PORT "flash_mosi" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "flash_miso" 62;
IO_PORT "flash_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
