// Internal PSRAM (two W955D8MBYA dies, 1.8 V bank). Pin list from
// psram_controller demo/tangnano9k/tangnano9k.cst at a2c41bd,
// https://github.com/takayuki-nagata/psram_controller
// Copyright (c) 2026 Takayuki Nagata
// SPDX-License-Identifier: MIT (see hw/third_party/psram_controller/LICENSE)
// Upstream derived the IOL locations from the Apicula GW1N-9C chip database.

// Die 0
IO_LOC  "O_psram_ck[0]" IOL8A;
IO_PORT "O_psram_ck[0]" IO_TYPE=LVCMOS18;
