# Store and check out every text file with LF, on every OS.
# Matches .editorconfig and the mixed-line-ending pre-commit hook.
* text=auto eol=lf

# FPGA build outputs and memory images that must never be converted
*.fs binary
*.bin binary

# Force LF for standard text and source files
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.py text eol=lf
*.css text eol=lf
*.html text eol=lf

# Force LF for all scripts
*.sh text eol=lf
*.bash text eol=lf
*.bat text eol=lf
*.cmd text eol=lf
*.ps1 text eol=lf
