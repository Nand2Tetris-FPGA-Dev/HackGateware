# Handle line endings automatically for text files
* text=auto

# Force LF for standard text and source files
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.py text eol=lf
*.css text eol=lf
*.html text eol=lf

# Force LF for all scripts
*.sh text eol=lf
*.bash text eol=lf
*.bat text eol=lf
*.cmd text eol=lf
*.ps1 text eol=lf
